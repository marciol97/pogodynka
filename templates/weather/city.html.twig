{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
<main>
    <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

    <ul>
        {% for measurement in measurements %}
        <li>{{ measurement.date|date('d.m.Y') }}:
            {{ measurement.tempCelsius }}&deg;C,
            wilgotność: {{ measurement.humidity }}%,
            ciśnienie: {{ measurement.pressure }}Pa,
            zachmurzenie: {{ measurement.cloudiness }}%
        </li>
        {% endfor %}
    </ul>
</main>
{% endblock %}
